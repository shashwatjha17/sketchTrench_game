# Copy to .env and fill in. NEVER commit the real .env file.
# The backend reads these via ${VAR:default} syntax in application.yml.

# ---- PostgreSQL ------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/sketchtrench
DB_USERNAME=sketchtrench
DB_PASSWORD=sketchtrench

# ---- Server ----------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- JWT (generate a long random string, e.g. openssl rand -base64 48) ----
# JWT_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
